<UserControl x:Class="Launcher.App.Views.Multiplayer.MultiplayerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:multiplayer="clr-namespace:Launcher.App.ViewModels.Multiplayer"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             xmlns:views="clr-namespace:Launcher.App.Views.Multiplayer"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="MultiplayerProjectHyperlinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 胶囊槽：浅色底 + 全圆角 -->
        <Style x:Key="TransportPillTrackStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.10FFFFFF}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="TransportPillStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillRoot"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Border x:Name="HoverLayer"
                                        CornerRadius="16"
                                        Background="{DynamicResource Brush.10FFFFFF}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 陶瓦内部的二级切换，比主胶囊更轻 -->
        <Style x:Key="TransportSubTabStyle"
               TargetType="Button"
               BasedOn="{StaticResource TransportPillStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="48,26,36,0">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding RequestLeaveLobbyCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLobbyStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}"
                        Style="{StaticResource ListPageHeaderBackButtonStyle}" />
                <TextBlock Text="{Binding HeaderTitle}"
                           VerticalAlignment="Center"
                           Style="{StaticResource ListPageHeaderTextStyle}" />
            </StackPanel>

            <!-- 联机方式：陶瓦 / 红石 -->
            <Border Margin="0,16,0,0"
                    Visibility="{Binding IsTransportSwitchVisible, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}"
                    Style="{StaticResource TransportPillTrackStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SelectTransportCommand}"
                            CommandParameter="{x:Static multiplayer:MultiplayerTransportKind.Terracotta}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TransportPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTerracottaSection}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Width="16"
                                              Height="16"
                                              IconKey="main_menu_Multiplayer"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Margin="8,0,0,0"
                                       Text="{x:Static res:Strings.Multiplayer_TransportTerracotta}"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </StackPanel>
                    </Button>

                    <Button Margin="4,0,0,0"
                            Command="{Binding SelectTransportCommand}"
                            CommandParameter="{x:Static multiplayer:MultiplayerTransportKind.Redstone}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TransportPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRedstoneSection}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Width="16"
                                              Height="16"
                                              IconKey="server"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Margin="8,0,0,0"
                                       Text="{x:Static res:Strings.Multiplayer_TransportRedstone}"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 陶瓦内部：创建房间 / 加入房间 -->
            <StackPanel Margin="2,10,0,0" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTerracottaSection}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLobbyStep}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Command="{Binding SelectTerracottaPageCommand}"
                        CommandParameter="{x:Static multiplayer:MultiplayerPageSection.CreateLobby}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TransportSubTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreateLobbySection}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.14FFFFFF}" />
                                    <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{x:Static res:Strings.Multiplayer_SectionCreateLobby}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>

                <Button Margin="4,0,0,0"
                        Command="{Binding SelectTerracottaPageCommand}"
                        CommandParameter="{x:Static multiplayer:MultiplayerPageSection.JoinLobby}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TransportSubTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsJoinLobbySection}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.14FFFFFF}" />
                                    <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{x:Static res:Strings.Multiplayer_SectionJoinLobby}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="SectionScrollViewer"
                      Grid.Row="1"
                      Margin="36,20,36,0"
                      Style="{StaticResource ListPageScrollViewerStyle}">
            <Grid x:Name="SectionContentRoot"
                  ClipToBounds="True"
                  Loaded="SectionContentRoot_OnLoaded"
                  Unloaded="SectionContentRoot_OnUnloaded">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>

                <views:CreateLobbyView>
                    <views:CreateLobbyView.Style>
                        <Style TargetType="{x:Type views:CreateLobbyView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreateLobbySection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLobbyStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:CreateLobbyView.Style>
                </views:CreateLobbyView>

                <views:JoinLobbyView>
                    <views:JoinLobbyView.Style>
                        <Style TargetType="{x:Type views:JoinLobbyView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsJoinLobbySection}" Value="True" />
                                        <Condition Binding="{Binding IsLobbyStep}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:JoinLobbyView.Style>
                </views:JoinLobbyView>

                <views:RedstoneOnlineView>
                    <views:RedstoneOnlineView.Style>
                        <Style TargetType="{x:Type views:RedstoneOnlineView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsRedstoneSection}" Value="True" />
                                        <Condition Binding="{Binding IsLobbyStep}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:RedstoneOnlineView.Style>
                </views:RedstoneOnlineView>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="TerracottaAttribution"
                   Grid.Row="1"
                   Panel.ZIndex="1"
                   Margin="36,0,36,50"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                   FontSize="12"
                   TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLobbyStep}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRedstoneSection}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Run Text="{x:Static res:Strings.Multiplayer_Create_TerracottaAttributionPrefix}" /><Hyperlink Command="{Binding OpenTerracottaProjectCommand}"
                                                                                                            Style="{StaticResource MultiplayerProjectHyperlinkStyle}"><Run Text="{x:Static res:Strings.Multiplayer_Create_TerracottaAttributionLinkText}" /></Hyperlink><Run Text="{x:Static res:Strings.Multiplayer_Create_TerracottaAttributionSuffix}" />
        </TextBlock>
    </Grid>
</UserControl>
