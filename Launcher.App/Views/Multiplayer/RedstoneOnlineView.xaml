<UserControl x:Class="Launcher.App.Views.Multiplayer.RedstoneOnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/mccsjs_launcher;component/Views/Settings/SettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 整页只保留一张主卡片，内容自上而下分层 -->
    <StackPanel Margin="0,0,0,8"
                MaxWidth="{StaticResource DetailPageContentMaxWidth}"
                HorizontalAlignment="Stretch">
        <Border Style="{StaticResource SectionFieldSurfaceStyle}"
                CornerRadius="12"
                Padding="24,22">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Redstone_SectionTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LauncherTextPrimaryBrush}" />

                <TextBlock Margin="0,8,0,0"
                           Text="{x:Static res:Strings.Redstone_Intro}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource LauncherTextSecondaryBrush}" />

                <!-- 端口与节点并排，避免表单纵向拉得过长 -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.Redstone_PortSection}"
                                   FontSize="13"
                                   Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                        <TextBox Margin="0,8,0,0"
                                 HorizontalAlignment="Stretch"
                                 MaxLength="5"
                                 Text="{Binding RedstoneGamePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsRedstoneEditable}"
                                 behaviors:TextBoxPlaceholder.Text="25565"
                                 Style="{StaticResource LauncherDialogTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0">
                        <TextBlock Text="{x:Static res:Strings.Redstone_NodeSection}"
                                   FontSize="13"
                                   Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                        <controls:AnimatedComboBox Margin="0,8,0,0"
                                                   HorizontalAlignment="Stretch"
                                                   ItemsSource="{Binding RedstoneNodes}"
                                                   SelectedItem="{Binding SelectedRedstoneNode, Mode=TwoWay}"
                                                   DisplayMemberPath="Name"
                                                   IsEnabled="{Binding IsRedstoneEditable}"
                                                   Style="{StaticResource LauncherComboBoxStyle}" />
                    </StackPanel>
                </Grid>

                <!-- 强调色描边的提示条，替代原先散落的说明文字 -->
                <Border Margin="0,20,0,0"
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{DynamicResource Brush.Accent.Selection}"
                        BorderBrush="{DynamicResource Brush.Accent.Outline}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:SvgIcon Grid.Column="0"
                                          Width="16"
                                          Height="16"
                                          IconKey="general/general_attention"
                                          Foreground="{DynamicResource Brush.Accent.Primary}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,10" />

                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="{x:Static res:Strings.Redstone_PortHint}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- 主操作在前，刷新节点为次要操作 -->
                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <Button Content="{Binding RedstoneStartButtonText}"
                            Command="{Binding StartRedstoneCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LauncherPrimaryDialogButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRedstoneRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{x:Static res:Strings.Redstone_Stop}"
                            Command="{Binding StopRedstoneCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LauncherDangerDialogButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRedstoneRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Margin="10,0,0,0"
                            Content="{x:Static res:Strings.Redstone_NodeRefresh}"
                            Command="{Binding RefreshRedstoneNodesCommand}"
                            Style="{StaticResource LauncherDialogButtonStyle}" />
                </StackPanel>

                <TextBlock Margin="0,12,0,0"
                           MaxWidth="560"
                           Text="{Binding RedstoneStatus}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasRedstoneStatus, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}"
                           Style="{StaticResource SettingsDescriptionTextStyle}" />

                <StackPanel Margin="0,22,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRedstoneSession}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{x:Static res:Strings.Redstone_AddressHeader}"
                               FontSize="13"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />

                    <Border Margin="0,8,0,0"
                            Padding="14,10"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Card.Border}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding RedstoneAddress}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource LauncherTextPrimaryBrush}" />

                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{Binding CopyRedstoneAddressCommand}"
                                    Style="{StaticResource InlineIconButtonStyle}">
                                <controls:SvgIcon Width="16"
                                                  Height="16"
                                                  IconKey="general/general_copy"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Text="{x:Static res:Strings.Redstone_AddressHint}"
                               Style="{StaticResource SettingsDescriptionTextStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
