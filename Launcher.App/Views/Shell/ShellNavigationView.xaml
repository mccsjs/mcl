<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:models="clr-namespace:Launcher.App.Models"
             x:Class="Launcher.App.Views.Shell.ShellNavigationView"
             x:Name="Root">
    <Grid>
        <controls:BackdropBlurBorder Style="{StaticResource PrimaryMenuBackdropStyle}"
            IsHitTestVisible="False" />

        <!-- 顶部横向导航条：背景留空，让下方标题栏拖拽区域继续响应窗口拖动。 -->
        <Border BorderBrush="{DynamicResource Brush.284E4E4E}"
                BorderThickness="0,0,0,1"
                ClipToBounds="True">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NavigationItem}">
                            <Button Style="{StaticResource NavigationMenuButtonStyle}"
                                    ToolTip="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand, ElementName=Root}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <controls:SvgIcon Width="24"
                                                      Height="24"
                                                      IconKey="{Binding IconKey}"
                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                        <controls:SvgIcon.Style>
                                            <Style TargetType="{x:Type controls:SvgIcon}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SvgIcon.Style>
                                    </controls:SvgIcon>

                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="{DynamicResource LauncherIconFontFamily}"
                                               FontSize="22"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource NavigationMenuAvatarContainerStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding AvatarUrl}"
                                               Stretch="Fill"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button DataContext="{Binding DownloadTasksNavigationItem}"
                        Style="{StaticResource NavigationMenuButtonStyle}"
                        Visibility="{Binding DataContext.DownloadTasksPage.HasRunningTasks, ElementName=Root, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}"
                        ToolTip="{Binding Title}"
                        Command="{Binding DataContext.NavigateCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                    <Grid>
                        <Ellipse x:Name="DownloadTaskPulseCircle"
                                 Width="40"
                                 Height="40"
                                 Fill="{DynamicResource Brush.66808080}"
                                 Opacity="0"
                                 CacheMode="BitmapCache"
                                 IsHitTestVisible="False"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DownloadTaskPulseScale"
                                                ScaleX="0.9"
                                                ScaleY="0.9" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <controls:SvgIcon Width="24"
                                          Height="24"
                                          IconKey="{Binding IconKey}"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
