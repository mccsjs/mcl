<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Application\Launcher.Application.csproj" />
    <ProjectReference Include="..\Launcher.Domain\Launcher.Domain.csproj" />
    <ProjectReference Include="..\Launcher.Infrastructure\Launcher.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\**\*.svg" />
    <Resource Include="Assets\Backgrounds\**\*.jpg" />
    <Resource Include="Assets\Icons\**\*.png" />
    <Resource Include="Effects\Shaders\ProgressiveGaussianBlur.ps" />
    <EmbeddedResource Include="Resources\ReferenceProjects.json"
                      LogicalName="Launcher.App.Resources.ReferenceProjects.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>mccsjs_launcher</AssemblyName>
    <RootNamespace>Launcher.App</RootNamespace>
    <AssemblyTitle>MCL Launcher</AssemblyTitle>
    <Title>MCL Launcher</Title>
    <Product>MCL Launcher</Product>
    <Version>0.9.16</Version>
    <LauncherBuildChannel>release</LauncherBuildChannel>
    <LauncherVersionCode>91699</LauncherVersionCode>
    <AssemblyVersion>0.9.16.0</AssemblyVersion>
    <FileVersion>0.9.16.0</FileVersion>
    <InformationalVersion>0.9.16</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\Icons\launcher_icon.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseChannel</_Parameter1>
      <_Parameter2>$(LauncherBuildChannel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>VersionCode</_Parameter1>
      <_Parameter2>$(LauncherVersionCode)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
